
# ==========================================
# Default text handling
# ==========================================

# Automatically detect text files and normalize to LF
* text=auto

# ==========================================
# Source code - LF line endings
# ==========================================

*.cs       text eol=lf
*.csx      text eol=lf
*.fs       text eol=lf
*.fsx      text eol=lf
*.vb       text eol=lf

# Project and solution files
*.sln      text eol=crlf
*.slnx     text eol=crlf
*.csproj   text eol=lf
*.fsproj   text eol=lf
*.vbproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf

# ==========================================
# Configuration and documentation
# ==========================================

*.json     text eol=lf
*.xml      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.config   text eol=lf
*.editorconfig text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.sh       text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ==========================================
# Web files (if applicable)
# ==========================================

*.html     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.jsx      text eol=lf

# ==========================================
# Git configuration files
# ==========================================

.gitattributes text eol=lf
.gitignore    text eol=lf
.gitmodules   text eol=lf

# ==========================================
# Binary files
# ==========================================

*.dll      binary
*.exe      binary
*.pdb      binary
*.so       binary
*.dylib    binary
*.a        binary
*.lib      binary
*.obj      binary
*.o        binary

*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.bmp      binary
*.webp     binary
*.pdf      binary
*.zip      binary
*.7z       binary
*.gz       binary

*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary

# ==========================================
# Visual Studio specific
# ==========================================

*.suo      binary
*.user     binary
*.cache    binary

# ==========================================
# Merge / Diff behavior
# ==========================================

# Lock files should not be merged automatically
*.lock     merge=ours

# Do not diff generated files
*.Designer.cs linguist-generated=true
*.g.cs        linguist-generated=true
*.g.i.cs      linguist-generated=true
